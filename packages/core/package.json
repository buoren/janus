{
  "name": "@buoren/janus-core",
  "version": "0.1.0",
  "description": "Pure TypeScript engine for decision-tree form visibility, pricing, validation, and answer resolution",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "jest --config jest.config.cjs",
    "typecheck": "npx tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Kevin Buoren Shiue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buoren/janus.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
