{
  "name": "@buoren/janus-react-core",
  "version": "0.1.0",
  "description": "Platform-agnostic React hooks + form logic for decision-tree registration forms (shared by @buoren/janus-react-native and @buoren/janus-react-dom)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@buoren/janus-core": "^0.1.0",
    "react": ">=18"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Kevin Buoren Shiue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buoren/janus.git",
    "directory": "packages/react-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@buoren/janus-core": "*",
    "@types/react": "^19.2.14",
    "react": "^19.2.4",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
