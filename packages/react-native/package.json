{
  "name": "@janus/react-native",
  "version": "0.1.0",
  "description": "React Native form components and hooks for decision-tree registration forms",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@janus/core": "^0.1.0",
    "@janus/react-core": "^0.1.0",
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Kevin Buoren Shiue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buoren/janus.git",
    "directory": "packages/react-native"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@janus/core": "*",
    "@janus/react-core": "*",
    "@types/react": "^19.2.14",
    "react": "^19.2.4",
    "react-native": "^0.83.2",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
